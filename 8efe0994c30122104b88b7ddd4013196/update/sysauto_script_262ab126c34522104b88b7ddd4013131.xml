var lutil = new LoanerUtils();

var plist = lutil.getNullPickupReminders();

if (plist.length === 0) {
    gs.info("No pickup reminders to send.");
} else {
    for (var i = 0; i < plist.length; i++) {
        try {
            lutil.sendPickupReminder(plist[i]);
            gs.info(`Reminder sent for item: ${plist[i].id}`);
        } catch (error) {
            gs.info(`Failed to send reminder for item: ${plist[i].id}`, error);
        }
    }
}

